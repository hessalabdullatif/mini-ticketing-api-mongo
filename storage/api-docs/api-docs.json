{
    "openapi": "3.0.0",
    "info": {
        "title": "Mini Ticketing API",
        "description": "Event ticketing API built with Laravel 13, MongoDB and Passport OAuth2.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8004/api",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "description": "Public. Creates a user with the \"user\" role and returns an access token. The role is assigned server-side and cannot be set by the client.",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Hessa"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "hessa@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created, token returned"
                    },
                    "422": {
                        "description": "Validation failed — email already taken or password too short"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in",
                "description": "Public. Returns an access token whose scopes depend on the user role.",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "hessa@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token returned"
                    },
                    "422": {
                        "description": "Credentials do not match"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log out",
                "description": "Revokes only the token used for this request, not every device.",
                "operationId": "28d48c13fca984400ac8de99f54ee13a",
                "responses": {
                    "200": {
                        "description": "Logged out"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/events": {
            "get": {
                "tags": [
                    "Events"
                ],
                "summary": "List events",
                "description": "Public endpoint. Optionally filter by city.",
                "operationId": "3befe2e8582683a8dc70f7b706a5a97d",
                "parameters": [
                    {
                        "name": "city",
                        "in": "query",
                        "description": "Filter events by city",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "Riyadh"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A paginated list of events"
                    }
                }
            },
            "post": {
                "tags": [
                    "Events"
                ],
                "summary": "Create an event",
                "description": "Requires a token carrying the events:create scope. A regular user's token receives 403.",
                "operationId": "1ed79d9ab6d41b87387cad6237213e5d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "city",
                                    "date"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Riyadh Season Concert"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Riyadh"
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-11-20"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "active",
                                        "enum": [
                                            "active",
                                            "paused",
                                            "cancelled"
                                        ]
                                    },
                                    "meta": {
                                        "description": "Free-form data that varies by event type",
                                        "type": "object",
                                        "example": {
                                            "artist": "Mohammed Abdu",
                                            "venue": "Mrsool Park"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Event created"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Token lacks the events:create scope"
                    },
                    "422": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/events/{id}": {
            "get": {
                "tags": [
                    "Events"
                ],
                "summary": "Get one event",
                "description": "Public. Includes the event's ticket types.",
                "operationId": "abf4f4bbfe75221b5bab720a701f17b8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The event id",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "6a842696e4e5ed74df0bee52"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The event with its tickets"
                    },
                    "404": {
                        "description": "Event not found"
                    }
                }
            }
        },
        "/orders": {
            "get": {
                "tags": [
                    "Orders"
                ],
                "summary": "List my orders",
                "description": "Returns only the authenticated user's own orders, read from the token. One user can never see another's.",
                "operationId": "8f3183bfa0ecb8a2c864cbf972b8061d",
                "responses": {
                    "200": {
                        "description": "A paginated list of your orders"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Orders"
                ],
                "summary": "Place an order",
                "description": "The total is computed server-side from the ticket price. Any total, status or user_id sent by the client is discarded.",
                "operationId": "b6490f9d9026dbe871b41207e118fffb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "event_id",
                                    "ticket_id",
                                    "quantity"
                                ],
                                "properties": {
                                    "event_id": {
                                        "type": "string",
                                        "example": "6a842696e4e5ed74df0bee52"
                                    },
                                    "ticket_id": {
                                        "type": "string",
                                        "example": "6a84285ecff6bfe1600b0c72"
                                    },
                                    "quantity": {
                                        "type": "integer",
                                        "example": 2,
                                        "maximum": 10,
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order created and paid"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Not enough tickets, or the event is paused, cancelled, or already past"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Obtain a token from /login, then send it as: Bearer {token}",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Events",
            "description": "Events"
        },
        {
            "name": "Orders",
            "description": "Orders"
        }
    ]
}